{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://anesis-server.onrender.com/schema/anesis.addon.schema.json",
	"title": "Anesis Addon Configuration",
	"description": "Strict validation schema for Anesis CLI addons",
	"type": "object",
	"additionalProperties": false,

	"required": [
		"schema_version",
		"id",
		"name",
		"version",
		"description",
		"author"
	],

	"properties": {
		"$schema": {
			"type": "string",
			"format": "uri"
		},

		"schema_version": {
			"type": "string",
			"const": "1"
		},

		"id": {
			"type": "string",
			"pattern": "^[a-z0-9-]+$",
			"minLength": 2,
			"maxLength": 60
		},

		"name": {
			"type": "string",
			"minLength": 2,
			"maxLength": 80
		},

		"version": {
			"type": "string",
			"pattern": "^\\d+\\.\\d+\\.\\d+$"
		},

		"description": {
			"type": "string",
			"minLength": 10,
			"maxLength": 300
		},

		"author": {
			"description": "Publisher. The object form matches templates and stacks and is what new addons should use; the bare string is accepted so addons published before 1.0 stay valid.",
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["name", "github"],
					"properties": {
						"name": { "type": "string", "minLength": 2, "maxLength": 80 },
						"github": { "type": "string", "pattern": "^[a-zA-Z0-9-]+$" }
					}
				},
				{
					"type": "string",
					"minLength": 2,
					"maxLength": 80
				}
			]
		},

		"requires": {
			"type": "array",
			"uniqueItems": true,
			"items": { "type": "string" }
		},

		"inputs": {
			"type": "array",
			"items": { "$ref": "#/$defs/inputDef" }
		},

		"detect": {
			"type": "array",
			"items": { "$ref": "#/$defs/detectBlock" }
		},

		"variants": {
			"type": "array",
			"items": { "$ref": "#/$defs/variant" }
		}
	},

	"$defs": {
		"inputDef": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "type"],
			"properties": {
				"name": { "type": "string" },
				"type": { "type": "string", "enum": ["text", "boolean", "select"] },
				"description": { "type": "string" },
				"default": { "type": "string" },
				"required": { "type": "boolean" },
				"options": { "type": "array", "items": { "type": "string" } }
			}
		},

		"detectBlock": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "rules"],
			"properties": {
				"id": { "type": "string" },
				"match": { "type": "string", "enum": ["all", "any"] },
				"rules": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/detectRule" }
				}
			}
		},

		"detectRule": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "file"],
					"properties": {
						"type": { "const": "file_exists" },
						"file": { "type": "string" },
						"negate": { "type": "boolean" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "file", "contains"],
					"properties": {
						"type": { "const": "file_contains" },
						"file": { "type": "string" },
						"contains": { "type": "string" },
						"negate": { "type": "boolean" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "file", "key_path"],
					"properties": {
						"type": { "const": "json_contains" },
						"file": { "type": "string" },
						"key_path": { "type": "string" },
						"value": { "type": "string" },
						"negate": { "type": "boolean" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "file", "key_path"],
					"properties": {
						"type": { "const": "toml_contains" },
						"file": { "type": "string" },
						"key_path": { "type": "string" },
						"value": { "type": "string" },
						"negate": { "type": "boolean" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "file", "key_path"],
					"properties": {
						"type": { "const": "yaml_contains" },
						"file": { "type": "string" },
						"key_path": { "type": "string" },
						"value": { "type": "string" },
						"negate": { "type": "boolean" }
					}
				}
			]
		},

		"variant": {
			"type": "object",
			"additionalProperties": false,
			"required": ["commands"],
			"properties": {
				"when": { "type": ["string", "null"] },
				"commands": {
					"type": "array",
					"items": { "$ref": "#/$defs/addonCommand" }
				}
			}
		},

		"addonCommand": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "steps"],
			"properties": {
				"name": { "type": "string" },
				"description": { "type": "string" },
				"once": { "type": "boolean" },
				"requires_commands": { "type": "array", "items": { "type": "string" } },
				"inputs": { "type": "array", "items": { "$ref": "#/$defs/inputDef" } },
				"steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
			}
		},

		"target": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "file"],
					"properties": {
						"type": { "const": "file" },
						"file": { "type": "string" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "glob"],
					"properties": {
						"type": { "const": "glob" },
						"glob": { "type": "string" }
					}
				}
			]
		},

		"ifExists": {
			"type": "string",
			"enum": ["ask", "overwrite", "skip"]
		},

		"ifNotFound": {
			"type": "string",
			"enum": ["warn_and_ask", "skip", "error"]
		},

		"step": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "src", "dest"],
					"properties": {
						"type": { "const": "copy" },
						"when": { "type": "string" },
						"src": { "type": "string" },
						"dest": { "type": "string" },
						"if_exists": { "$ref": "#/$defs/ifExists" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "path", "content"],
					"properties": {
						"type": { "const": "create" },
						"when": { "type": "string" },
						"path": { "type": "string" },
						"content": { "type": "string" },
						"if_exists": { "$ref": "#/$defs/ifExists" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"not": { "required": ["after", "before"] },
					"required": ["type", "target", "content"],
					"properties": {
						"type": { "const": "inject" },
						"when": { "type": "string" },
						"target": { "$ref": "#/$defs/target" },
						"content": { "type": "string" },
						"after": { "type": "string" },
						"before": { "type": "string" },
						"if_not_found": { "$ref": "#/$defs/ifNotFound" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "target", "find", "replace"],
					"properties": {
						"type": { "const": "replace" },
						"when": { "type": "string" },
						"target": { "$ref": "#/$defs/target" },
						"find": { "type": "string" },
						"replace": { "type": "string" },
						"if_not_found": { "$ref": "#/$defs/ifNotFound" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "target", "content"],
					"properties": {
						"type": { "const": "append" },
						"when": { "type": "string" },
						"target": { "$ref": "#/$defs/target" },
						"content": { "type": "string" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "target"],
					"properties": {
						"type": { "const": "delete" },
						"when": { "type": "string" },
						"target": { "$ref": "#/$defs/target" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "from", "to"],
					"properties": {
						"type": { "const": "rename" },
						"when": { "type": "string" },
						"from": { "type": "string" },
						"to": { "type": "string" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "from", "to"],
					"properties": {
						"type": { "const": "move" },
						"when": { "type": "string" },
						"from": { "type": "string" },
						"to": { "type": "string" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type"],
					"properties": {
						"type": { "const": "packages" },
						"when": { "type": "string" },
						"dependencies": { "type": "array", "items": { "type": "string" } },
						"dev_dependencies": { "type": "array", "items": { "type": "string" } }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "command"],
					"properties": {
						"type": { "const": "run" },
						"when": { "type": "string" },
						"command": { "type": "string" },
						"description": { "type": "string" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "path"],
					"properties": {
						"type": { "const": "json_patch" },
						"when": { "type": "string" },
						"path": { "type": "string" },
						"set": { "type": "object" },
						"remove": { "type": "array", "items": { "type": "string" } }
					}
				}
			]
		}
	}
}
